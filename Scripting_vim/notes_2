" Vim reserved word as function option
	" the range option allows for two additional variables.
	" since we know that all this function is dealing with a range
	" strucutre THEN 

function ExpurgateText (text) abort
	let expurgated = a:text		" a:__some_Arg__
	for expletive in g:expletive_list
		let expurgated = substitute(expurgated, expletive, '[DELETE]', 'g')
		endfor
	return expurgated
endfunction

