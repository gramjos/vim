# git
.git/
*/.git/*
# ===================================================================
# Vim
# ===================================================================
# Swap files (These were in your repo and should be ignored)
*.sw[a-p]
*.swp
*.swo
*.swn
.*.swp

# Backup files
*~
*.bak

# Undo files
*.un~
*.undo

# Session and View files
Session.vim
*vimview*
.vim/view/

# ===================================================================
# Generated by your specific .vimrc
# ===================================================================
# Your .vimrc generates a 'tags' file, which should not be in Git
tags

# ===================================================================
# macOS (As requested)
# ===================================================================
# General metadata
.DS_Store
.AppleDouble
.LSOverride

# Resource forks
._*

# Files that might appear in the root of a volume
.Spotlight-V100
.Trashes
.fseventsd

# ===================================================================
# Python (For your scripts in ~/.vim/scripts/)
# ===================================================================
# Byte-compiled files
*.pyc
*.pyo
*.pyd

# Cache
__pycache__/
.mypy_cache/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# =D==================================================================
# Zsh (As requested)
# ===================================================================
# Compiled zsh files
*.zwc

# Zsh history (though usually in $HOME)
.zsh_history

# ===================================================================
# Archives & Compressed Files
# ===================================================================
# These are binaries and don't belong in Git
*.zip
*.tar.gz
*.tar
*.rar
*.7z
