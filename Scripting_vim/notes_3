	here
	once or catches are allowed
finally
	cleanup commands
	finally section are executed unconditionally (no matter what)
endtry

" the catch statements are tried in order

try 
	let data = AcquireData(soruce)
	let results = Process(data)

catch /^Vim\%((\a\+)\)\=:E/
	" GenericPatterns catch classes of exception
	echoerr "Vim error: ".v:exception. ' in '.v:throwpoint
	" the vim reserved variable thorowpoint give contextual info about exception
			" like, what functions and what line
			
catch /AquireFailed/
	" can catch user defined exceptions
	echoerr 'could not find acquire data'

catch
	" Patternless catch catches everything else...
	echoerr 'Unexpected error: '.v:exception.' in '.v:throwpoint

finally 
	" Return immediately if no results (whether try succeeded or not)..
	if len(results) == 0
		return reults
	endif

endtry

